{
  "name": "lucifer-invoice-studio",
  "productName": "Lucifer Invoice Studio",
  "version": "1.0.0",
  "description": "Premium Wedding & Multi-Industry Invoice & Billing Studio for Windows",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron dist-electron/main.js\"",
    "electron:build": "npm run build && npm run build:electron && electron-builder --win",
    "electron:pack": "npm run build && npm run build:electron && electron-builder --dir",
    "test": "vitest run"
  },
  "keywords": [
    "invoice",
    "wedding-planner",
    "gst-invoice",
    "billing",
    "desktop-app",
    "electron",
    "windows"
  ],
  "author": "Lucifer Open Source <ailuciferbaba@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/luciferopensource/InvoiceX-Studio"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.lucifer.invoicexstudio",
    "productName": "Lucifer Invoice Studio",
    "copyright": "Copyright © 2026 Lucifer Open Source",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lucifer Invoice Studio",
      "runAfterFinish": true
    }
  }
}
